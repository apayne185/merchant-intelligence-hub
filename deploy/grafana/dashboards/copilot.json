    {
      "id": 13,
      "type": "timeseries",
      "title": "Span-derived latency p95 (OTel spanmetrics)",
      "description": "From the collector's spanmetrics connector - trace-derived, independent of the app's /metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
