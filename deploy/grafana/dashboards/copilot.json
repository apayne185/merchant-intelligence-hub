      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_requests_total{handler!=\"/metrics\"}[5m]))",
          "legendFormat": "{{status}}"
        }
