# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
.env
.env.local

# C++ build trees
cpp/riskcore/build/

# IDEs / OS
.vscode/
.idea/
*.swp
.DS_Store

# Test / lint caches
.pytest_cache/
.ruff_cache/
