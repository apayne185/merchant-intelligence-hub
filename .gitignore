# Secrets
*.key
*.pem

# Local-only data that is never part of the product
data/transactions_sample.csv

# outputs/ is versioned on purpose (eval and benchmark reports are evidence).
# The trace file sink is not: it grows without bound and can contain request text.
outputs/traces.jsonl*

# Planning notes
context/

# Terraform: state can contain resource attributes and ARNs; never in git.
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfstate.*.backup
terraform/.terraform.tfstate.lock.info
terraform/terraform.tfvars
terraform/*.auto.tfvars
terraform/crash.log
